# Normalize line endings so diffs reflect real changes, not CRLF/LF churn.
* text=auto eol=lf

*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.txt text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Binary — never touch line endings.
*.gguf binary
*.png binary
*.jpg binary
*.jpeg binary
